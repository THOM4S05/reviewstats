APP_NAME=ReviewStats - Review Attribution Platform
DATABASE_URL=sqlite:///./review_attribution.db
PUBLIC_BASE_URL=http://localhost:8000
MAX_REVIEW_DELAY_MINUTES=60
SCAN_ORDER_GRACE_MINUTES=90
REVIEW_DESTINATION=mock
DEFAULT_BUSINESS_NAME=Demo Burger Bar
DEFAULT_LOCATION_NAME=Main location
DEFAULT_TIMEZONE=Europe/Dublin
DEFAULT_GOOGLE_REVIEW_URL=https://search.google.com/local/writereview?placeid=YOUR_PLACE_ID

# Optional API protection for local experiments; this is not browser login or production security.
REQUIRE_TENANT_AUTH=false
TENANT_API_KEY=
ATTRIBUTION_ALGORITHM_VERSION=v2.1-scanpoint

# Existing experimental provider adapter. Live import is not part of the verified demo.
GOOGLE_ACCESS_TOKEN=
GOOGLE_ACCOUNT_ID=
GOOGLE_LOCATION_ID=
